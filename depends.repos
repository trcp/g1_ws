repositories:
    # unitree sdk
    unitree_ros2:
        type: git
        url: https://github.com/unitreerobotics/unitree_ros2.git
        version: master

    unitree_sdk2:
        type: git
        url: https://github.com/unitreerobotics/unitree_sdk2.git
        version: main

    # livox pkgs
    livox_ros_driver2:
        type: git
        url: https://github.com/Livox-SDK/livox_ros_driver2.git
        version: master

    Livox-SDK2:
        type: git
        url: https://github.com/Livox-SDK/Livox-SDK2.git
        version: master

    # FAST-LIO
    fast_lio:
        type: git
        url: https://github.com/Ericsii/FAST_LIO_ROS2.git
        version: ros2
        
    fast_lio/include/ikd-Tree:
        type: git
        url: https://github.com/hku-mars/ikd-Tree.git
        version: fast_lio
