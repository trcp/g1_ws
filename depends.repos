repositories:
    # unitree sdk
    unitree_ros2:
        type: git
        url: https://github.com/unitreerobotics/unitree_ros2.git
        version: master

    unitree_sdk2:
        type: git
        url: https://github.com/unitreerobotics/unitree_sdk2.git
        version: main

    # nakatogawa packages
    nakalab_realsense:
        type: git
        url: https://github.com/GAI-313/nakalab_realsense.git
        version: main

    # for Temporary Subscriber util
    rclpy_util:
        type: git
        url: https://github.com/GAI-313/rclpy_util.git
        version: main

    # 2D localization
    emcl2:
        type: git
        url: https://github.com/GAI-313/emcl2_for_kachaka.git
        version: main

    # 3D Localization
    lidar_localization_ros2:
        type: git
        url: https://github.com/rsasaki0109/lidar_localization_ros2.git
        version: main

    ndt_omp_ros2:
        type: git
        url: https://github.com/rsasaki0109/ndt_omp_ros2.git
        version: humble
    
    pointcloud_to_2dmap:
        type: git
        url: https://github.com/koide3/pointcloud_to_2dmap.git
        version: master

    # livox pkgs
    livox_ros_driver2:
        type: git
        url: https://github.com/Livox-SDK/livox_ros_driver2.git
        version: master

    Livox-SDK2:
        type: git
        url: https://github.com/Livox-SDK/Livox-SDK2.git
        version: master
