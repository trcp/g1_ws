repositories:
    # unitree sdk
    thirdparty/unitree_ros2:
        type: git
        url: https://github.com/unitreerobotics/unitree_ros2.git
        version: master

    thirdparty/unitree_sdk2:
        type: git
        url: https://github.com/unitreerobotics/unitree_sdk2.git
        version: main

    # nakatogawa packages
    thirdparty/nakalab_realsense:
        type: git
        url: https://github.com/GAI-313/nakalab_realsense.git
        version: main

    # for Temporary Subscriber util
    thirdparty/rclpy_util:
        type: git
        url: https://github.com/GAI-313/rclpy_util.git
        version: main

    # 2D localization
    thirdparty/emcl2:
        type: git
        url: https://github.com/GAI-313/emcl2_for_kachaka.git
        version: main

    # 3D Localization
    thirdparty/lidar_localization_ros2:
        type: git
        url: https://github.com/rsasaki0109/lidar_localization_ros2.git
        version: main

    thirdparty/ndt_omp_ros2:
        type: git
        url: https://github.com/rsasaki0109/ndt_omp_ros2.git
        version: humble
    
    thirdparty/pointcloud_to_2dmap:
        type: git
        url: https://github.com/koide3/pointcloud_to_2dmap.git
        version: master

    # livox pkgs
    thirdparty/livox_ros_driver2:
        type: git
        url: https://github.com/Livox-SDK/livox_ros_driver2.git
        version: master

    # ultralytics ros2:
    thirdparty/nakalab_ultralytics_ros2:
        type: git
        url: https://github.com/GAI-313/nakalab_ultralytics_ros2.git
        version: main

    # Japanese TTS
    thirdparty/voicevox_ros2:
        type: git
        url: https://github.com/GAI-313/voicevox_ros2.git
        version: humble
